# ---------------------------------------------------------------------------
# GameJournal environment configuration
#
# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local
# `.env.local` is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# Supabase project (Settings -> API)
# Both values are required. The app fails fast on boot with a clear message if
# they are missing, rather than erroring deep inside the Supabase SDK.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# IGDB / Twitch API (https://www.igdb.com/api)
# Optional. Without these the game search falls back to whatever is already
# cached in the `games` table, and the UI explains that search is unavailable.
IGDB_CLIENT_ID=your-igdb-client-id
IGDB_CLIENT_SECRET=your-igdb-client-secret

# Absolute site URL, used for canonical links, sitemap.xml, robots.txt and the
# OG image URLs. Set this in production to your real domain.
NEXT_PUBLIC_SITE_URL=https://gamejournal.vercel.app
